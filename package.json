{
  "name": "typeless-rebuild",
  "version": "1.0.0-rc.6",
  "license": "MIT",
  "author": "YU contributors",
  "private": true,
  "description": "YU Windows AI assistant with voice input and local tools",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "spike:hook": "node scripts/spike-hook.mjs",
    "spike:insert": "node scripts/spike-insert.mjs",
    "spike:windows": "node scripts/spike-windows.mjs",
    "mock": "node scripts/mock-openai.mjs",
    "icon": "node scripts/make-icon.mjs",
    "package": "electron-vite build && electron-builder --win nsis --publish never",
    "release:archives": "node scripts/release.mjs"
  },
  "dependencies": {
    "chrono-node": "2.10.3",
    "electron-updater": "^6.6.2",
    "koffi": "^2.14.1",
    "sherpa-onnx-node": "1.13.8",
    "sherpa-onnx-win-x64": "1.13.8"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^42.11.18",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "i18next": "^25.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^4.1.12"
  }
}
