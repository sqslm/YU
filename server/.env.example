# YU 自建服务端配置示例
#
# 用法：复制成 .env（docker compose 会自动读取），或 export 到进程环境。
# 真实密钥只放在 .env 或部署平台的 secret 里，不要提交到仓库。
# /admin 中保存的服务设置优先于这里的对应值，重启后保留。
# CLI reset-web-settings 后重启可清除 Web 覆盖并恢复环境变量（包括注册覆盖）。

# ---------------------------------------------------------------- 基础
# 0.0.0.0 让容器外可访问；只在本机反代时也可以写 127.0.0.1。
HOST=0.0.0.0
PORT=8787

# 数据库、音频、备份都放在这个目录里，必须是持久化卷。
DATA_DIR=/data

# 对外可访问的地址，会显示在 /api/v1/meta 里，便于客户端提示。
# 反代到 https://sync.example.com 时填这个；留空表示不声明。
PUBLIC_URL=

# debug / info / warn / error
LOG_LEVEL=info

# ---------------------------------------------------------------- 账号
# 是否允许任何人注册。留空/不设置时：配好 SMTP 就默认开放，没配 SMTP 就默认关闭。
# 管理员随时可以在 CLI 用 `registration on|off` 覆盖这个值。
REGISTRATION_ENABLED=

# 注册与找回密码是否必须输入邮箱验证码。关掉只适合完全私有、没有 SMTP 的实例。
EMAIL_VERIFICATION_REQUIRED=true

# 验证码有效期与冷却时间（秒）
CODE_TTL_SECONDS=300
CODE_COOLDOWN_SECONDS=60
# 同一个验证码最多试错几次
CODE_MAX_ATTEMPTS=5

# 会话时长：访问令牌秒数、刷新令牌天数
ACCESS_TTL_SECONDS=43200
REFRESH_TTL_DAYS=90

# 新账号的试用期（天）。到期后账号仍可登录，只是订阅状态显示为过期。
TRIAL_DAYS=14

# ---------------------------------------------------------------- 配额
# 每个账号默认的音频存储总量（MB），最小为 1
DEFAULT_USER_STORAGE_MB=1024
# 单个音频文件上限（MB）
MAX_AUDIO_UPLOAD_MB=50
# JSON 请求体上限（字节）
MAX_BODY_BYTES=2097152

# ---------------------------------------------------------------- SMTP
# 不配置 SMTP 也能跑：这时公开注册会被强制关闭，只能用 CLI 建号。
SMTP_HOST=
# 465 = 隐式 TLS（implicit），587 = STARTTLS。按服务商要求选。
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
# 发件人，建议写成 "YU <no-reply@example.com>"
SMTP_FROM=
# implicit / starttls / none。none 只允许在非生产环境使用。
SMTP_TLS_MODE=implicit
SMTP_TIMEOUT_SECONDS=10

# QQ 邮箱示例：
#   SMTP_HOST=smtp.qq.com
#   SMTP_PORT=465
#   SMTP_USERNAME=你的QQ邮箱
#   SMTP_PASSWORD=授权码（不是登录密码）
#   SMTP_FROM=YU <你的QQ邮箱>
#   SMTP_TLS_MODE=implicit
# 163 邮箱示例：
#   SMTP_HOST=smtp.163.com
#   SMTP_PORT=465
#   SMTP_TLS_MODE=implicit
# Gmail 示例：
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_TLS_MODE=starttls
#   SMTP_PASSWORD=应用专用密码

# ---------------------------------------------------------------- 限流
# 每个 IP 每分钟的总请求数，0 关闭
RATE_LIMIT_PER_MINUTE=240
# 认证接口每个 IP 每分钟的请求数
AUTH_LIMIT_PER_MINUTE=20
# 验证码：每 IP / 每邮箱 每小时
CODE_LIMIT_PER_HOUR_PER_IP=20
CODE_LIMIT_PER_HOUR_PER_EMAIL=5

# ---------------------------------------------------------------- 反代
# 只有放在 Caddy/Nginx/Traefik 后面才开；直连时开启会让客户端伪造 IP。
TRUST_PROXY=0
# 桌面客户端不是浏览器，默认 * 即可；要收紧就写具体来源。
CORS_ORIGIN=*
