# Publish the editable project, never workstation data or captured vendor files.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/PROVIDER_API_AUDIT.md
!/THIRD_PARTY_NOTICES.md
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig*.json
!/vitest.config.ts
!/electron.vite.config.ts
!/electron-builder.yml
!/src/
!/build/
!/resources/
!/licenses/
!/server/
!/scripts/
/scripts/*
!/scripts/mock-openai.mjs
!/scripts/make-icon.mjs
!/scripts/release.mjs
**/node_modules/
**/data/
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.log
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.tar
**/*.tar.gz
**/*.zip
