# Publish the editable project, never workstation data or captured vendor files.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/README.en.md
!/PROVIDER_API_AUDIT.md
!/THIRD_PARTY_NOTICES.md
!/ASSISTANT_ROADMAP.md
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig*.json
!/vitest.config.ts
!/electron.vite.config.ts
!/electron-builder.yml
!/src/
!/build/
!/resources/
!/tests/
/tests/*
!/tests/yu-v2/
!/logo/
!/licenses/
!/server/
!/scripts/
/scripts/*
!/scripts/mock-openai.mjs
!/scripts/make-icon.mjs
!/scripts/make-icon.py
!/scripts/release.mjs
!/scripts/evaluate-entities.mjs
!/scripts/evaluate-memory.cjs
!/scripts/verify-memory-runtime.cjs
!/scripts/benchmark-memory.cjs
**/node_modules/
**/data/
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.log
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.tar
**/*.tar.gz
**/*.zip
