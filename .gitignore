!/docs/plans/2026-11-03-rust-wake-correctness-dsh.md
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig*.json
!/vitest.config.ts
!/electron.vite.config.ts
!/electron-builder.yml
!/src/
!/build/
!/resources/
!/tests/
/tests/*
!/tests/yu-v2/
!/logo/
!/licenses/
!/server/
!/scripts/
/scripts/*
!/scripts/mock-openai.mjs
!/scripts/make-icon.mjs
!/scripts/make-icon.py
!/scripts/release.mjs
!/scripts/evaluate-entities.mjs
!/scripts/evaluate-memory.cjs
